53361 34.99986723 2.89880949 37.2353316 6.1875 40.265625 C8.57845797 42.55352444 8.95620545 43.78540672 9.625 47.0625 C8.78323138 52.36564229 6.27803892 54.48140916 2.5546875 58.1796875 C-0.40903435 60.29145261 -2.38432954 60.81897184 -6 61 C-10.74293617 58.58013461 -14.09065049 55.44959337 -17 51 C-18.11903434 46.12420754 -18.11903434 46.12420754 -17 43 C-14.85109789 40.47535665 -12.58424913 38.3311178 -10.06640625 36.17578125 C-7.72516306 33.71061592 -7.21498263 32.35703652 -7 29 C-8.52895229 25.3687383 -10.81277088 23.25901226 -13.6875 20.6875 C-16.21782445 18.20562857 -17.5490317 16.58455561 -17.8125 13 C-17.35762013 8.1195181 -14.52265045 5.17122214 -11 2 C-7.00108773 -1.19912982 -4.90114786 -1.27697401 0 0 Z\" fill=\"#19B391\" transform=\"translate(182,167)\"/></svg>\n  <span style=\"font-size:13px;font-weight:700;letter-spacing:2px;color:#fff;text-transform:uppercase\">PYLONTECH</span>\n  <span style=\"font-size:9px;color:#555;margin-left:4px\">BMS Console (RS232)</span>\n</div>\n\n\n  <div v-if=\"!bms || !bms.modules || !bms.modules.length\" style=\"text-align:center; padding:24px 0; color:#888\">\n    <div style=\"font-size:13px\">No data yet &ndash; switch <strong>Live</strong> on.</div>\n  </div>\n  <div v-if=\"bms && bms.modules && bms.modules.length\" style=\"font-size:12px; line-height:1.3\">\n\n    <!-- Pack summary -->\n    <div v-if=\"bms.pack\" style=\"margin-bottom:6px; padding:5px 7px; border-radius:4px;\n              background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12)\">\n      <div class=\"d-flex justify-space-between\" style=\"font-size:10px; color:#888; margin-bottom:3px\">\n        <span><strong style=\"color:#bbb\">PACK</strong>\n          &nbsp;{{ bms.n_modules }} mod &nbsp;·&nbsp;\n          {{ bms.pack.nominal_ah }} Ah nom &nbsp;·&nbsp;\n          {{ bms.pack.nominal_kwh }} kWh\n        </span>\n        <span><span v-if=\"bms.live\" style=\"color:#4caf50; font-weight:700\">&#9679; LIVE</span>&nbsp;{{ bms.updated }}</span>\n      </div>\n      <div class=\"d-flex align-center\" style=\"gap:12px; flex-wrap:wrap; font-size:12px\">\n        <span>SOC <strong>{{ bms.pack.soc_pct }}%</strong></span>\n        <span :style=\"{color: bms.pack.curr_a < -1 ? '#ffa726' : bms.pack.curr_a > 1 ? '#42a5f5' : '#888'}\">\n          {{ bms.pack.curr_a > 0 ? '+' : '' }}{{ bms.pack.curr_a.toFixed(1) }} A\n        </span>\n        <span style=\"color:#9e9e9e\">{{ bms.pack.avg_temp_c }}°C</span>\n        <span style=\"color:#9e9e9e; font-size:10px\">\n          cap {{ bms.pack.cap_ah }} Ah &nbsp;({{ bms.pack.energy_kwh }} kWh)\n          &nbsp;·&nbsp;SOH <span :style=\"{color: sc(100 - bms.pack.soh_pct, 5, 15)}\">{{ bms.pack.soh_pct }}%</span>\n        </span>\n        <span style=\"margin-left:auto; font-size:10px; color:#888\">\n          spread: <span :style=\"{color: sc(bms.total_spread_mv,10,30)}\" title=\"max − min cell across the whole pack. ≤10 mV excellent · ≤30 mV normal · >30 mV watch\">{{ bms.total_spread_mv }} mV</span><span style=\"font-size:9px;margin-left:3px\" :style=\"{color:sc(bms.total_spread_mv,10,30)}\">{{ bms.total_spread_mv<=10?\"✓\":bms.total_spread_mv<=30?\"ok\":\"!\" }}</span>\n        </span>\n      </div>\n    </div>\n\n    <!-- One row per module -->\n    <div v-for=\"m in bms.modules\" :key=\"m.id\"\n         style=\"margin-bottom:5px; padding:5px 7px 4px; border-radius:4px;\n                background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07)\">\n\n      <!-- Row 1: model + serial + firmware (click: lifetime counters) -->\n      <div class=\"d-flex justify-space-between\" style=\"font-size:10px; color:#666; margin-bottom:3px; cursor:pointer\"\n           @click=\"toggleMod(m.id)\" title=\"Show / hide the module's lifetime counters (stat)\">\n        <span>\n          <v-icon size=\"12\" color=\"#888\">{{ openMods[m.id] ? 'mdi-chevron-up' : 'mdi-chevron-down' }}</v-icon>\n          <strong style=\"color:#aaa\">M{{ m.id }}</strong>\n          &nbsp;{{ m.model }}\n          &nbsp;<span style=\"font-family:monospace; color:#888\">{{ m.barcode }}</span>\n        </span>\n        <span><span v-if=\"bms.live && m.cells_age_s != null\" style=\"color:#555\">cells {{ Math.round(m.cells_age_s) }} s ago &nbsp;</span>fw {{ m.fw }}</span>\n      </div>\n\n      <!-- Row 2: live data -->\n      <div class=\"d-flex align-center\" style=\"gap:10px; margin-bottom:4px; flex-wrap:wrap\">\n\n        <span>SOC <strong>{{ m.soc_pct }}%</strong></span>\n\n        <span :style=\"{color: m.curr_a < -0.5 ? '#ffa726' : m.curr_a > 0.5 ? '#42a5f5' : '#888'}\">\n          {{ m.curr_a > 0 ? '+' : '' }}{{ m.curr_a.toFixed(1) }} A\n        </span>\n\n        <span style=\"color:#9e9e9e\">{{ m.avg_temp_c }}°C</span>\n\n        <span style=\"color:#9e9e9e; font-size:10px\">\n          cap {{ m.cap_ah }} Ah\n          <span v-if=\"m.soh_pct !== null && m.soh_pct !== undefined\">\n            &nbsp;·&nbsp;SOH\n            <span :style=\"{color: sc(100 - m.soh_pct, 5, 15)}\">{{ m.soh_pct }}%</span><span style=\"font-size:9px;color:#555\"> {{ m.soh_source }}</span>\n          </span>\n          <span v-if=\"m.cycles !== null && m.cycles !== undefined\">\n            &nbsp;·&nbsp;<span style=\"color:#666\">{{ m.cycles }} cycles</span>\n          </span>\n          <span v-if=\"m.bat_hv_times > 0\"\n                style=\"color:#ffa726\"\n                :title=\"'BHV alarm: cell reached ' + (bms.thresholds ? bms.thresholds.bhv_mv : 3600) + 'mV\\n' + (m.hv_cells && m.hv_cells.length ? 'Cells: ' + m.hv_cells.join(', ') : '') + (m.last_hv_date ? '\\nLast: ' + m.last_hv_date : '')\">\n            &nbsp;⚠ BHV×{{ m.bat_hv_times }}<span v-if=\"m.hv_cells && m.hv_cells.length\" style=\"font-size:9px\"> B{{ m.hv_cells.join(',') }}</span>\n          </span>\n        </span>\n\n        <span style=\"margin-left:auto; font-size:10px; color:#888\">\n          {{ m.min_v_mv }} / {{ m.avg_v_mv }} / {{ m.max_v_mv }} mV\n          &nbsp;Δ<span :style=\"{color: sc(m.spread_mv,5,20)}\" title=\"max − min cell within the module. ≤5 mV excellent · ≤20 mV normal · >20 mV watch\">{{ m.spread_mv }} mV</span><span style=\"font-size:9px;margin-left:2px\" :style=\"{color:sc(m.spread_mv,5,20)}\">{{ m.spread_mv<=5?\"✓\":m.spread_mv<=20?\"ok\":\"!\" }}</span>\n        </span>\n      </div>\n\n      <!-- BHV cell markers: orange strip = module reached 3600mV (bat_hv_times > 0) -->\n      <div v-if=\"m.bat_hv_times > 0\" class=\"d-flex\" style=\"height:5px; gap:1px; margin-bottom:1px\">\n        <div v-for=\"c in m.cells\" :key=\"'hv'+c.cell\"\n             :style=\"{flex:'1', borderRadius:'1px', background:'rgba(255,152,0,0.5)'}\"\n             :title=\"'M'+m.id+' reached 3600 mV — '+m.bat_hv_times+'× (BHV alarm). The specific cell is not available from the BMS.'\">\n        </div>\n      </div>\n\n      <!-- Cell bars -->\n      <div class=\"d-flex align-stretch\" style=\"height:16px; gap:1px\">\n        <div v-for=\"c in m.cells\" :key=\"c.cell\"\n             :title=\"'B'+c.cell+': '+c.v_mv+' mV | '+c.soc_pct+'% | '+c.temp_c+'°C'\"\n             :style=\"{flex:'1', background:cellSocColor(c.soc_pct, packSocRange.min, packSocRange.max), borderRadius:'2px'}\">\n        </div>\n      </div>\n\n      <!-- Cell index labels -->\n      <div class=\"d-flex justify-space-between\" style=\"font-size:9px; color:#555; margin-top:1px\">\n        <span>0</span>\n        <span>{{ Math.floor(m.n_cells/2) }}</span>\n        <span>{{ m.n_cells-1 }}</span>\n      </div>\n\n      <!-- Lifetime counters (stat N), opened by clicking the module header -->\n      <div v-if=\"openMods[m.id]\" style=\"margin-top:6px; padding-top:6px; border-top:1px solid rgba(255,255,255,0.08); font-size:10px\">\n        <div v-if=\"!m.stats || !m.stats.operation.length\" style=\"color:#666\">Counters not read yet &ndash; they arrive within a minute after Live starts.</div>\n        <template v-else>\n          <div class=\"d-flex justify-space-between\" style=\"color:#666; margin-bottom:4px\">\n            <span>Lifetime counters of the module (<code>stat {{ m.id }}</code>)<span v-if=\"m.stats_read_at\">, read {{ fmtTs(m.stats_read_at * 1000) }}</span></span>\n            <span style=\"cursor:pointer; color:#888; text-decoration:underline\" @click=\"showZeros = !showZeros\">{{ showZeros ? 'hide zero values' : 'show zero values' }}</span>\n          </div>\n          <div v-for=\"g in statGroups\" :key=\"g.key\" style=\"margin-bottom:6px\">\n            <div style=\"color:#aaa; font-weight:700; margin-bottom:2px\">\n              {{ g.title }}\n              <span v-if=\"!showZeros && zeroCount(m.stats[g.key])\" style=\"color:#555; font-weight:400\">&nbsp;(+{{ zeroCount(m.stats[g.key]) }} zero)</span>\n            </div>\n            <div style=\"display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); column-gap:14px\">\n              <div v-for=\"it in visibleStats(m.stats[g.key])\" :key=\"it[0]\" class=\"d-flex justify-space-between\" :title=\"it[0] + ': ' + it[1]\">\n                <span :style=\"{color: g.key === 'alarms' && !isZero(it[1]) ? '#ffa726' : '#777'}\">{{ it[0] }}</span>\n                <span :style=\"{color: isZero(it[1]) ? '#444' : (g.key === 'alarms' ? '#ffa726' : '#ccc'), fontFamily: 'monospace'}\">{{ it[2] }}</span>\n              </div>\n            </div>\n          </div>\n        </template>\n      </div>\n    </div>\n\n    <!-- Legend -->\n    <div class=\"d-flex align-center\" style=\"gap:6px; font-size:10px; color:#666; margin-top:4px\">\n      <span style=\"flex-shrink:0\">Cell SOC:</span>\n      <div style=\"display:flex;gap:1px;align-items:center\">\n        <span style=\"display:inline-block;width:10px;height:10px;background:hsl(120,52%,20%);border-radius:2px\"></span>\n        <span style=\"display:inline-block;width:10px;height:10px;background:hsl(120,60%,32%);border-radius:2px\"></span>\n        <span style=\"display:inline-block;width:10px;height:10px;background:hsl(120,65%,44%);border-radius:2px\"></span>\n        <span style=\"display:inline-block;width:10px;height:10px;background:hsl(120,70%,58%);border-radius:2px\"></span>\n      </div>\n      <span>low → high (relative within the module)</span>\n    </div>\n\n\n  <!-- BHV history -->\n  <div v-if=\"bms && bms.bhv_history && bms.bhv_history.length > 0\" style=\"margin-top:8px\">\n    <div @click=\"bhvOpen=!bhvOpen\" style=\"cursor:pointer;font-size:10px;color:#ef9a9a;user-select:none;display:flex;align-items:center;gap:4px\">\n      <v-icon size=\"12\" color=\"#ef9a9a\">mdi-alert-circle-outline</v-icon>\n      BHV counter increases seen ({{ bms.bhv_history.length }}) <span style=\"color:#555\">&ndash; time = when the dashboard noticed it</span> <v-icon size=\"12\">{{ bhvOpen?'mdi-chevron-up':'mdi-chevron-down' }}</v-icon>\n    </div>\n    <div v-if=\"bhvOpen\" style=\"margin-top:4px;font-size:9px;font-family:monospace;max-height:160px;overflow-y:auto\">\n      <div v-for=\"(e,i) in bms.bhv_history.slice().reverse()\" :key=\"i\"\n           style=\"padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;gap:6px\">\n        <span style=\"color:#666;min-width:75px\">{{ fmtTs(e.ts) }}</span>\n        <span style=\"color:#ef9a9a;min-width:22px\">M{{ e.module }}</span>\n        <span style=\"color:#aaa;min-width:52px\">{{ e.model }}</span>\n        <span style=\"color:#fff\">+{{ e.count_delta }} (total {{ e.count_new }})</span>\n        <span v-if=\"e.hv_cells && e.hv_cells.length\" style=\"color:#ffa726\">cells: {{ e.hv_cells.join(',') }}</span>\n        <span v-if=\"e.last_hv_date\" style=\"color:#555;margin-left:auto\">{{ e.last_hv_date }}</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Spread legend -->\n  <div style=\"margin-top:6px;font-size:9px;color:#555;display:flex;gap:10px;flex-wrap:wrap;padding:0 2px\">\n    <span><span style=\"color:#4caf50\">■</span> pack≤10 / mod≤5 mV — excellent</span>\n    <span><span style=\"color:#ffa726\">■</span> pack≤30 / mod≤20 mV — normal</span>\n    <span><span style=\"color:#ef5350\">■</span> above limit — watch</span>\n    <span style=\"margin-left:auto;color:#444\">balancing starts >3360 mV/cell</span>\n  </div>\n  </div>\n  <div v-else style=\"padding:16px; text-align:center; color:#666; font-size:12px\">Waiting for BMS…</div>\n</template>\n\n<script>\nexport default {\n  data() { return { bhvOpen: false, openMods: {}, showZeros: false }; },\n  computed: {\n    statGroups() {\n      return [\n        { key: 'alarms',    title: 'Alarms & protections (times)' },\n        { key: 'operation', title: 'Operation' },\n        { key: 'time',      title: 'Time spent in ranges' },\n        { key: 'records',   title: 'Stored records' }\n      ];\n    },\n    bms() { return this.msg && this.msg.payload ? this.msg.payload : null; },\n    packSocRange() {\n      var min = 100, max = 0;\n      if (this.bms && this.bms.modules) {\n        this.bms.modules.forEach(function(m) {\n          m.cells.forEach(function(c) {\n            if (c.soc_pct < min) min = c.soc_pct;\n            if (c.soc_pct > max) max = c.soc_pct;\n          });\n        });\n      }\n      return { min: min, max: max };\n    }\n  },\n  methods: {\n    toggleMod(id) {\n      var o = Object.assign({}, this.openMods); o[id] = !o[id]; this.openMods = o;\n    },\n    isZero(v) { return v === '0' || v === '0.0'; },\n    zeroCount(items) { var self = this; return (items || []).filter(function(it) { return self.isZero(it[1]); }).length; },\n    visibleStats(items) {\n      var self = this;\n      return (items || []).filter(function(it) { return self.showZeros || !self.isZero(it[1]); });\n    },\n    cellSocColor(soc, minSoc, maxSoc) {\n      var t = (maxSoc > minSoc) ? (soc - minSoc) / (maxSoc - minSoc) : 0.5;\n      var l = Math.round(20 + t * 38);\n      var sat = Math.round(52 + t * 18);\n      return 'hsl(120,' + sat + '%,' + l + '%)';\n    },\n    sc(val, warn, crit) {\n      if (val <= warn) return '#4caf50';\n      if (val <= crit) return '#ffa726';\n      return '#ef5350';\n    },\n    fmtTs(ts) {\n      var d = new Date(ts);\n      return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')\n        +' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');\n    }\n  }\n}\n</script>\n",
    "storeOutMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
