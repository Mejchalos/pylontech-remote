    "z": "batt-tab-01",
    "name": "Live controller",
    "func": "// Starts / stops the live reader (pylontech_live.py) from the Live switch.\n// Inputs: msg.topic 'live' (switch true/false) or the exec node's return code (process ended).\n// Outputs: 1 exec (start / kill), 2 status text, 3 switch state.\nconst running = context.get('running') === true;\nconst st = (t) => ({ payload: t });\n\nif (msg.topic === 'live') {\n    context.set('wanted', msg.payload === true);\n    if (msg.payload === true) {\n        if (running) return [null, st('Live už běží'), null];\n        context.set('running', true);\n        return [{ payload: '' }, st('Spouštím live…'), null];\n    }\n    if (running) return [{ kill: 'SIGTERM' }, st('Vypínám live…'), null];\n    return [null, st('Live vypnuto'), null];\n}\n\n// return code from the exec node: the reader has ended\nif (msg.payload && typeof msg.payload === 'object' && 'code' in msg.payload) {\n    context.set('running', false);\n    const wanted = context.get('wanted') === true;\n    context.set('wanted', false);\n    const code = msg.payload.code;\n    if (!wanted) return [null, st('Live vypnuto'), null];\n    const why = {\n        0: 'Live se samo vypnulo po 30 minutách',\n        2: 'Live nejde spustit: port je obsazený nebo baterie neodpovídá',\n        3: 'Live přerušeno: chyba komunikace s baterií',\n    }[code] || ('Live skončilo (kód ' + code + ')');\n    return [null, st(why), { payload: false }];\n}\nreturn null;",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "// After a deploy or restart nothing is running (the exec node kills its process on redeploy).\ncontext.set('running', false);\ncontext.set('wanted', false);",
    "finalize": "",
