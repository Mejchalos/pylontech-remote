  {
    "id": "pylon-live-snapshot",
    "type": "function",
    "z": "batt-tab-01",
    "name": "Snapshot → widget",
    "func": "// One JSON snapshot per line from pylontech_live.py (same shape as the original reader output).\n// Outputs: 1 widget, 2 status text (only on errors / when live starts).\nvar data = msg.payload;\nif (!data || typeof data !== 'object') { return null; }\nif (!data.ok || !data.modules || !data.modules.length) {\n    return [null, { payload: 'Chyba: ' + (data.error || 'žádná data') }];\n}\ndata.updated = new Date().toLocaleTimeString('cs-CZ');\n\n// --- BHV counter: record increases that happen while the dashboard is watching ---\n// m.bat_hv_times is the battery's lifetime counter (from `stat`). The first value seen for a\n// module is only remembered (baseline) - it is history, not a new event. Keyed by serial number.\nvar STORE = undefined; // default context store\nvar bhvHistory = flow.get('bhv_history', STORE) || [];\nvar prevCounts  = flow.get('bhv_prev_counts', STORE) || {};\nvar now = Date.now();\nvar changed = false;\nif (flow.get('bhv_cleanup_v1', STORE) !== true) {\n    // drop entries made by the old logic on first sight (whole lifetime count as one \"event\")\n    bhvHistory = bhvHistory.filter(function(e) { return e.count_delta !== e.count_new; });\n    prevCounts = {};\n    flow.set('bhv_cleanup_v1', true, STORE);\n    changed = true;\n}\ndata.modules.forEach(function(m) {\n    if (typeof m.bat_hv_times !== 'number' || !m.barcode || m.barcode === '?') { return; }\n    var key = m.barcode;\n    var curr = m.bat_hv_times;\n    if (!(key in prevCounts)) {\n        prevCounts[key] = curr;          // baseline\n        changed = true;\n        return;\n    }\n    var prev = prevCounts[key];\n    if (curr > prev) {\n        bhvHistory.push({\n            ts:          now,\n            iso:         new Date(now).toISOString(),\n            module:      m.id,\n            model:       m.model,\n            barcode:     m.barcode,\n            count_new:   curr,\n            count_delta: curr - prev,\n            last_hv_date: m.last_hv_date || null,\n            hv_cells:    m.hv_cells || []\n        });\n    }\n    if (curr !== prev) {\n        prevCounts[key] = curr;\n        changed = true;\n    }\n});\n// max 200 records\nif (bhvHistory.length > 200) bhvHistory = bhvHistory.slice(-200);\nif (changed) {\n    flow.set('bhv_history',    bhvHistory,  STORE);\n    flow.set('bhv_prev_counts', prevCounts, STORE);\n}\ndata.bhv_history = bhvHistory;\n\nvar status = null;\nif (data.live && context.get('wasLive') !== true) {\n    status = { payload: 'Live běží – celý stack včetně článků se obnovuje najednou' };\n}\ncontext.set('wasLive', data.live === true);\nmsg.payload = data;\nreturn [msg, status];",
